{#- src/remote_mcp/templates_sources/database/tools.py.j2 -#}
"""Database tools — generated by remote-mcp {{ generator_version }} from {{ locator }}.

Owned code: no runtime dependency on remote-mcp.
SECURITY MODEL: API tools act as the caller; database tools act as the server.
Read-only by default; write tools exist only for explicitly allowlisted
table:operation pairs. There is no generic run_sql tool by design.
"""
from __future__ import annotations

from typing import Any

from fastmcp import Context, FastMCP

from src.core.errors import ValidationError
from src.core.handlers import tool_handler
from src.tools.db.db import DB_MAX_ROWS, run_query, run_write

db_router = FastMCP("db")

# Keyed by the original (wire) table/column names — this is what callers
# pass as order_by= / column= and must match the SQL dicts below, which are
# keyed the same way.
ORDER_BY_COLUMNS = {
{%- for t in tables %}
    {{ t.wire_name | tojson }}: ({% for c in t.columns %}{{ c.wire_name | tojson }}, {% endfor %}),
{%- endfor %}
}

{% for t in tables %}

@db_router.tool()
@tool_handler
async def list_{{ t.name }}(ctx: Context, limit: int = 50, offset: int = 0, order_by: str = {{ t.order_by_default | tojson }}) -> list[dict[str, Any]]:
    """List rows from {{ t.wire_name }} (max rows capped by DB_MAX_ROWS)."""
    allowed = ORDER_BY_COLUMNS[{{ t.wire_name | tojson }}]
    if order_by not in allowed:
        raise ValidationError(f"order_by must be one of {allowed}")
    limit = max(1, min(limit, DB_MAX_ROWS))
    sql = {{ t.list_sql_by_order }}[order_by]
    return await run_query(sql, ({{ t.limit_params }}))
{% if t.pk %}

@db_router.tool()
@tool_handler
async def get_{{ t.name }}_by_{{ t.pk.name }}(ctx: Context, {{ t.pk.name }}: {{ t.pk.py_type }}) -> list[dict[str, Any]]:
    """Fetch one {{ t.wire_name }} row by {{ t.pk.wire_name }}."""
    return await run_query({{ t.get_sql }}, ({{ t.pk.name }},))
{% endif %}

@db_router.tool()
@tool_handler
async def search_{{ t.name }}(ctx: Context, column: str, value: str, limit: int = 50) -> list[dict[str, Any]]:
    """Search {{ t.wire_name }} by equality on an allowlisted column."""
    allowed = ORDER_BY_COLUMNS[{{ t.wire_name | tojson }}]
    if column not in allowed:
        raise ValidationError(f"column must be one of {allowed}")
    limit = max(1, min(limit, DB_MAX_ROWS))
    sql = {{ t.search_sql_by_column }}[column]
    return await run_query(sql, ({{ t.search_params }}))
{% if "insert" in t.write_ops %}

@db_router.tool()
@tool_handler
async def insert_{{ t.name }}(ctx: Context{% for c in t.insert_columns %}, {{ c.name }}: {{ c.py_type }}{% if c.nullable %} | None = None{% endif %}{% endfor %}) -> dict[str, Any]:
    """INSERT one row into {{ t.wire_name }}. Explicitly enabled via --allow-write."""
    count = await run_write({{ t.insert_sql }}, ({% for c in t.insert_columns %}{{ c.name }}, {% endfor %}))
    return {"inserted": True, "rows": count}
{% endif %}
{% if "update" in t.write_ops and t.pk %}

@db_router.tool()
@tool_handler
async def update_{{ t.name }}_by_{{ t.pk.name }}(ctx: Context, {{ t.pk.name }}: {{ t.pk.py_type }}{% for c in t.update_columns %}, {{ c.name }}: {{ c.py_type }} | None = None{% endfor %}) -> dict[str, Any]:
    """UPDATE allowlisted columns on one {{ t.wire_name }} row. Explicitly enabled via --allow-write."""
    updates = {k: v for k, v in { {% for c in t.update_columns %}{{ c.name | tojson }}: {{ c.name }},{% endfor %} }.items() if v is not None}
    if not updates:
        raise ValidationError("Provide at least one column to update.")
    sql = {{ t.update_sql_by_column }}
    total = 0
    for col, val in updates.items():
        total += await run_write(sql[col], (val, {{ t.pk.name }}))
    return {"updated": True, "statements": total}
{% endif %}
{% endfor %}
