"""Database access — generated by remote-mcp {{ generator_version }} from {{ locator }}.

Owned code: no runtime dependency on remote-mcp.
SECURITY MODEL: API tools act as the caller; database tools act as the server.
These tools run with the server's DATABASE_URL credentials — whatever the
MCP-layer auth admits can read every allowlisted table.
"""
from __future__ import annotations

import asyncio
import logging
import os
from typing import Any

logger = logging.getLogger(__name__)

# Configurable via env vars: DB_MAX_ROWS caps rows returned per call;
# db_statement_timeout_ms (read from DB_STATEMENT_TIMEOUT_MS) caps how long a
# single statement may run before this module raises asyncio.TimeoutError.
DB_MAX_ROWS = int(os.environ.get("DB_MAX_ROWS", "200"))
_TIMEOUT_S = int(os.environ.get("DB_STATEMENT_TIMEOUT_MS", "5000")) / 1000.0

if os.environ.get("AUTH_MODE", "passthrough").lower() == "none":
    logger.warning(
        "db tools are mounted with AUTH_MODE=none: every unauthenticated caller "
        "can read all allowlisted tables with the server's credentials."
    )


def _database_url() -> str:
    url = os.environ.get("DATABASE_URL", "")
    if not url:
        raise RuntimeError("DATABASE_URL is not set; db tools cannot run.")
    return url

{% if dialect == "sqlite" %}

async def _execute(sql: str, params: tuple) -> tuple[list[str], list[tuple]]:
    import aiosqlite

    path = _database_url().replace("sqlite:///", "", 1)
    async with aiosqlite.connect(path) as conn:
        cursor = await conn.execute(sql, params)
        columns = [d[0] for d in cursor.description] if cursor.description else []
        rows = await cursor.fetchmany(DB_MAX_ROWS)
        await conn.commit()
        return columns, [tuple(r) for r in rows]
{% elif dialect == "postgresql" %}

async def _execute(sql: str, params: tuple) -> tuple[list[str], list[tuple]]:
    import asyncpg

    conn = await asyncpg.connect(_database_url())
    try:
        records = await conn.fetch(sql, *params)
        columns = list(records[0].keys()) if records else []
        return columns, [tuple(r) for r in records[:DB_MAX_ROWS]]
    finally:
        await conn.close()
{% elif dialect == "mysql" %}

async def _execute(sql: str, params: tuple) -> tuple[list[str], list[tuple]]:
    import urllib.parse

    import aiomysql

    u = urllib.parse.urlparse(_database_url())
    conn = await aiomysql.connect(
        host=u.hostname, port=u.port or 3306, user=u.username,
        password=u.password or "", db=u.path.lstrip("/"),
    )
    try:
        async with conn.cursor() as cursor:
            await cursor.execute(sql, params)
            columns = [d[0] for d in cursor.description] if cursor.description else []
            rows = await cursor.fetchmany(DB_MAX_ROWS)
            await conn.commit()
            return columns, [tuple(r) for r in rows]
    finally:
        conn.close()
{% endif %}

async def run_query(sql: str, params: tuple = ()) -> list[dict[str, Any]]:
    """Row-capped, timeout-wrapped read. Returns list of dicts."""
    columns, rows = await asyncio.wait_for(_execute(sql, params), timeout=_TIMEOUT_S)
    return [dict(zip(columns, row)) for row in rows]


async def run_write(sql: str, params: tuple = ()) -> int:
    """Timeout-wrapped write. Returns affected/returned row count."""
    _, rows = await asyncio.wait_for(_execute(sql, params), timeout=_TIMEOUT_S)
    return len(rows)
